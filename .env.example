# Wysyłka formularza kontaktowego (src/app/api/contact/route.ts).
# Skopiuj do .env.local (lokalnie) albo ustaw jako zmienne środowiskowe kontenera.
#
# Ustawienia dla poczty OVH (Zimbra / MX Plan):
#   host:  smtp.mail.ovh.net (alternatywnie ssl0.ovh.net)
#   port:  465 (SSL/TLS) - zalecany; 587 (STARTTLS) też działa
#   login: pełny adres e-mail (nie sama część przed @)
SMTP_HOST=smtp.mail.ovh.net
SMTP_PORT=465
SMTP_USER=grzegorz.urban@gosqu-software.pl
# Hasło do skrzynki (to samo co do webmaila). Nie commituj prawdziwego hasła.
SMTP_PASS=twoje-haslo
# Adres, na który trafiają wiadomości z formularza.
CONTACT_TO=grzegorz.urban@gosqu-software.pl
# Nadawca. OVH wymaga, żeby był to adres tej samej skrzynki, na którą się logujesz.
# Domyślnie SMTP_USER.
CONTACT_FROM="Gosqu Software <grzegorz.urban@gosqu-software.pl>"
